# Copy to .env and fill in. LLM calls go through OpenRouter.
OPENROUTER_API_KEY=sk-or-...
# Optional: override the OpenAI-compatible base URL (defaults to OpenRouter).
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional: Firecrawl search + page scraping (set search_provider: firecrawl too).
# FIRECRAWL_API_KEY=fc-...
